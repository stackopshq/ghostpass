# GhostPass auto-hébergé — copier en `.env` et remplir.
#
#   cp .env.example .env
#
# Les deux premières lignes n'ont PAS de valeur par défaut, volontairement :
# un secret livré avec le logiciel est le même chez tout le monde, donc n'est
# pas un secret. La pile refuse de démarrer tant qu'ils sont vides.

# Mot de passe PostgreSQL. Générer :  openssl rand -base64 32
POSTGRES_PASSWORD=

# Clé de chiffrement du secret du second facteur, au repos.
#
# FACULTATIVE, et le serveur démarre sans — mais il vous le dira à chaque
# démarrage, parce que sans elle le secret TOTP est stocké EN CLAIR : quiconque
# lit la base peut générer les codes 2FA de tous les comptes.
#
# Ce que ça protège : le vol de la base seule, ou d'une sauvegarde. Ce que ça
# ne protège pas : quelqu'un qui obtient la base ET ce fichier.
#
# Générer :  openssl rand -hex 32
# ⚠️ La perdre rend les secrets 2FA existants illisibles. La sauvegarder.
MFA_SECRET_KEY=

# Clé de signature des jetons du proxy de favicons. Facultative : sans elle,
# une clé est tirée au démarrage et les clients redemandent simplement un jeton
# après un redémarrage. Générer :  openssl rand -hex 32
ICON_TOKEN_SECRET=

# ─── Version ───
# Épingler une empreinte plutôt qu'une balise mouvante :
#   GHOSTPASS_TAG=sha-4424e7a
GHOSTPASS_TAG=main

# ─── Réseau ───
# 127.0.0.1 par défaut : la pile n'est PAS exposée tant que vous ne le décidez
# pas. Mettez 0.0.0.0 seulement derrière un terminateur TLS.
BIND_ADDR=127.0.0.1

# ─── WebAuthn (clés d'accès et second facteur matériel) ───
# Exige un contexte sécurisé (https, ou localhost) et un NOM DE DOMAINE —
# une adresse IP ne marche pas, et l'échec survient à l'enrôlement d'une clé,
# pas au démarrage.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080

# ─── Vie privée ───
# Le proxy de favicons émet une requête vers chaque site enregistré, et apprend
# donc son domaine. `false` le désactive : c'est la seule façon de supprimer
# cette requête, qui est inhérente au principe.
ICONS_ENABLED=true

# ─── Journalisation ───
# `info` journalise les requêtes servies, sans jamais l'IP ni la chaîne de
# requête : le sérialiseur ne rend que la méthode et le gabarit de route.
LOG_LEVEL=info

# ─── Rétention ───
# En jours. Ce sont les valeurs par défaut ; un auto-hébergeur n'a pas les
# obligations d'un service vendu et peut les raccourcir.
# RETENTION_LOGIN_EVENTS_DAYS=90
# RETENTION_AUDIT_LOG_DAYS=365
