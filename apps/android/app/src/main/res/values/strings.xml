    <string name="modele_mfa_absent">Ce serveur ne propose pas encore le second facteur.</string>
    <!-- Les entrées d'un import que le serveur a refusées. Le reste se **compte**, donc il
         se décline : « et 1 autre » n'est pas « et 2 autres ». Le second trou est vide
         quand il n'y a pas de reste — c'est pourquoi la ponctuation finale est dans le
         pluriel et non dans la phrase. -->
    <string name="modele_non_deposes">Non déposés : %1$s%2$s</string>
    <plurals name="modele_et_autres">
        <item quantity="one"> et %d autre.</item>
        <item quantity="other"> et %d autres.</item>
    </plurals>

