    <string name="modele_sso_identite_verifiee">Identité vérifiée. Entrez votre mot de passe maître pour ouvrir le coffre.</string>
    <string name="modele_totp_export_multiple">Ce QR code est un export d\'application d\'authentification, qui porte plusieurs comptes à la fois. GhostPass ne sait pas le lire : exportez les comptes un par un.</string>
    <string name="modele_totp_lien_inutilisable">Ce lien n\'est pas un second facteur utilisable — il lui manque un secret, ou il n\'est pas de type « totp ».</string>
    <string name="modele_cle_non_preparee">Cet appareil n\'a pas pu préparer la clé : %1$s</string>
    <string name="modele_bio_titre">Activer le déverrouillage biométrique</string>
    <string name="modele_bio_sous_titre">GhostPass gardera la clé de votre coffre sous votre empreinte.</string>
    <string name="modele_bio_echec">L\'activation a échoué : %1$s</string>
    <string name="modele_pas_de_secret_a_partager">Cet élément n\'a pas de secret unique à partager.</string>
    <string name="modele_partage_revoque">Partage annulé et révoqué.</string>
    <string name="modele_partage_non_revocable">Partage annulé, mais ce serveur ne permet pas de le révoquer.</string>
    <string name="modele_partage_revocation_echouee">Le partage n\'a pas pu être révoqué : %1$s</string>
    <string name="modele_partage_refuse_schema">Le serveur a rendu un lien en clair alors qu\'il est joint en HTTPS. Le partage a été annulé.</string>
    <string name="modele_partage_refuse_sans_jeton">Le serveur a rendu un lien vers un autre domaine sans jeton de révocation : impossible de reprendre ce partage. Rien ne sera affiché.</string>
