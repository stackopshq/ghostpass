    <!-- Un nom de produit ne se traduit pas : `translatable="false"` le dit, et dispense
         `values-en/` d'en tenir une copie identique. C'est aussi ce que vérifie
         `tools/android/temoin-des-traductions.sh`. -->
    <string name="app_name" translatable="false">GhostPass</string>
    <string name="remplissage_deverrouiller">Déverrouiller GhostPass</string>
    <string name="remplissage_ce_site">Pour ce site</string>
    <string name="remplissage_enregistrement_indisponible">L\'enregistrement depuis une autre application n\'est pas encore disponible.</string>
    <!-- Décrit le service dans les réglages du système. Aucun tarif, aucun renvoi vers un
         achat : l\'application est gratuite et doit le rester jusque dans ses chaînes (§7). -->
    <string name="service_de_remplissage">GhostPass remplit vos identifiants, après déverrouillage.</string>
    <!-- ─── Les pluriels ───

         **Jamais « caractère(s) ».** iOS a affiché « 1 mots de passe à revoir » et
         « 1 consultation(s) » ; la parenthèse est la forme qui ne se trompe jamais et ne se
         lit bien jamais non plus. Android sait faire, et c'est `plurals` qu'il faut.

         `one` et `other` : en français, `one` couvre 0 et 1 — « 0 caractère », « 1
         caractère ». C'est `PluralRules` qui le décide, d'après la langue de la
         configuration, pas d'après le dossier où vit la ressource. Tant que l'application
         n'est qu'en français ces chaînes vivent dans `values/` ; le jour où elle se traduit,
         elles descendront dans `values-fr/` et les deux formes seront déjà en place. -->
    <plurals name="generateur_longueur">
        <item quantity="one">Longueur — %d caractère</item>
        <item quantity="other">Longueur — %d caractères</item>
    </plurals>
    <plurals name="coffre_illisibles_ecartes">
        <item quantity="one">%d élément illisible ne peut pas être filtré : il n\'a pas de nom à comparer.</item>
        <item quantity="other">%d éléments illisibles ne peuvent pas être filtrés : ils n\'ont pas de nom à comparer.</item>
    </plurals>
    <plurals name="remplissage_illisibles">
        <item quantity="one">%d élément du coffre n\'a pas pu être ouvert et n\'est pas proposé ici.</item>
        <item quantity="other">%d éléments du coffre n\'ont pas pu être ouverts et ne sont pas proposés ici.</item>
    </plurals>
    <!-- « 1 mots de passe à revoir » : c'est exactement ce qu'iOS affichait. Un coffre
         qui n'a qu'un seul défaut est le cas le plus fréquent, donc celui sur lequel la
         phrase se trompait le plus souvent. -->
    <plurals name="sante_a_revoir">
        <item quantity="one">%d mot de passe à revoir</item>
        <item quantity="other">%d mots de passe à revoir</item>
    </plurals>
    <plurals name="sante_examines">
        <item quantity="one">%d élément examiné</item>
        <item quantity="other">%d éléments examinés</item>
    </plurals>
    <plurals name="reglages_elements">
        <item quantity="one">%d élément</item>
        <item quantity="other">%d éléments</item>
    </plurals>
    <plurals name="reglages_coffres">
        <item quantity="one">%d coffre</item>
        <item quantity="other">%d coffres</item>
    </plurals>
    <!-- iOS écrit « \u0025d entrées importées. » sans accord : à une entrée près, la phrase
         est fausse. Les quatre formes ci-dessous couvrent les quatre endroits où l'écran
         d'import compte quelque chose. -->
    <plurals name="import_entrees">
        <item quantity="one">%d entrée</item>
        <item quantity="other">%d entrées</item>
    </plurals>
    <plurals name="import_bouton">
        <item quantity="one">Importer %d entrée</item>
        <item quantity="other">Importer %d entrées</item>
    </plurals>
    <plurals name="import_importees">
        <item quantity="one">%d entrée importée.</item>
        <item quantity="other">%d entrées importées.</item>
    </plurals>
    <plurals name="import_et_autres">
        <item quantity="one">et %d autre</item>
        <item quantity="other">et %d autres</item>
    </plurals>

    <!-- ─── Le modèle du coffre ───

