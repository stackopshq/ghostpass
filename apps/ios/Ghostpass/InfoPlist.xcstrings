    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "new",
            "value": "L'appareil photo lit le QR code d'un second facteur. Aucune image n'est enregistrée ni transmise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera reads the QR code of a second factor. No image is stored or transmitted."
          }
        }
