        }
      }
    },
    "Inviter quelqu'un lui scelle la clé de l'équipe vers sa clé publique. Le serveur ne transporte qu'un blob qu'il ne peut pas ouvrir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviting someone seals the team key to their public key. The server only carries a blob it cannot open."
          }
        }
      }
    },
