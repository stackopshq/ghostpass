          "stringUnit": {
            "state": "translated",
            "value": "No key has been handed to you for this vault yet."
          }
        }
      }
    },
    "Aucune collection ne vous est ouverte dans cette équipe. Un administrateur doit vous y donner accès.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No collection is open to you in this team. An administrator must grant you access."
          }
        }
      }
    },
