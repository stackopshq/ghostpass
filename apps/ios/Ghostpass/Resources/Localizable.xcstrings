    "Peut lire et modifier les identifiants partagés.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can read and edit the shared credentials."
          }
        }
      }
    },
    "Peut lire, sans rien modifier.": {
      "localizations": {
