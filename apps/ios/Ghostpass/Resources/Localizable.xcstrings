          }
        }
      }
    },
    "Il est chiffré sur cet appareil. Le serveur n'en reçoit que le chiffre, jamais la clé.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is encrypted on this device. The server only receives the ciphertext, never the key."
          }
        }
      }
    },
    "Il est vérifié sur cet appareil et n'en sort pas : le serveur n'en reçoit qu'une empreinte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is verified on this device and does not leave it: the server only receives a hash."
          }
        }
      }
    },
