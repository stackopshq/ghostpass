<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Manifeste de confidentialité de l'extension de remplissage.

  Elle porte le sien parce qu'elle est un binaire distinct : Apple lit un manifeste par
  bundle, et celui de l'application ne couvre pas son extension.

  · `UserDefaults` — elle lit les préférences partagées via le groupe d'applications
    (CredentialProviderViewController). Même raison CA92.1 que l'application.

  · Rien de collecté. L'extension travaille hors ligne, sur la copie locale du coffre
    déposée par l'application : elle n'ouvre aucune connexion et ne transmet rien. C'est
    d'ailleurs ce qui lui permet de remplir un formulaire sans réseau.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>

    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
</dict>
</plist>
