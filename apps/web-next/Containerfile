# Image de l'interface GhostPass.
#
# CE QU'ELLE CONTIENT, ET POURQUOI CE N'EST PAS QU'UN LOT DE FICHIERS STATIQUES
# ----------------------------------------------------------------------------
# L'interface appelle l'API par des chemins RELATIFS (`/api/auth/login`, etc. —
# voir `src/lib/api.ts`). Elle doit donc être servie depuis la MÊME ORIGINE que
# le serveur, sans quoi chaque appel part vers un chemin qui n'existe pas.
#
# Ce n'est pas un détail de confort : WebAuthn lie ses clés à une origine. Un
# découpage en deux noms de domaine ne « marcherait avec un peu de CORS » — il
# rendrait les clés d'accès inutilisables, et l'échec n'apparaîtrait qu'au
# moment de se reconnecter.
#
# L'image embarque donc un nginx qui sert le lot statique ET relaie vers le
# serveur. La cible du relais est injectée au démarrage par `GHOSTPASS_API`
# (mécanisme `templates/*.conf.template` de l'image nginx officielle), pour que
# le nom du conteneur voisin ne soit pas gravé dans l'image.
#
# TROIS ÉTAGES, PARCE QUE LE PAQUET WASM N'EST PAS DANS LE DÉPÔT
# ---------------------------------------------------------------
# `package.json` déclare `ghostpass-crypto-wasm` en `file:../../crates/...
# /pkg` — un répertoire qui n'existe QUE s'il a été construit. `npm ci` échoue
# tant que le WASM n'est pas là. L'ordre des étages n'est donc pas un choix de
# style : Rust d'abord, npm ensuite.
#
# CE QUI EST SERVI : L'INTERFACE NEXT, EXPORTÉE EN FICHIERS STATIQUES
# -------------------------------------------------------------------
# Jusqu'au 2026-08-29 cette image servait `apps/web`, écrit en Svelte. Toute
# l'application est cliente — elle déchiffre avec une clé que le serveur n'a
# pas — donc `output: "export"` ne renonce à rien et garde la forme éprouvée :
# un nginx, une seule origine, pas de processus Node à surveiller.

# ---------------------------------------------------------------------------
# Étage 1 — le cœur cryptographique, compilé en WebAssembly
# ---------------------------------------------------------------------------
FROM docker.io/library/rust:1.90-bookworm AS wasm

# Le nom de l'archive porte l'architecture : une somme de contrôle juste sur la
# mauvaise architecture est une vérification qui rassure sans rien prouver.
ARG WASM_PACK_VERSION=0.13.1
ARG WASM_PACK_SHA256=c539d91ccab2591a7e975bcf82c82e1911b03335c80aa83d67ad25ed2ad06539
RUN set -eux; \
    f="wasm-pack-v${WASM_PACK_VERSION}-x86_64-unknown-linux-musl.tar.gz"; \
    curl -sSL -o /tmp/wp.tgz \
      "https://github.com/rustwasm/wasm-pack/releases/download/v${WASM_PACK_VERSION}/${f}"; \
    echo "${WASM_PACK_SHA256}  /tmp/wp.tgz" | sha256sum -c -; \
    tar -xzf /tmp/wp.tgz -C /tmp --strip-components=1; \
    install -m 0755 /tmp/wasm-pack /usr/local/bin/wasm-pack; \
    rm -rf /tmp/wp.tgz /tmp/wasm-pack

RUN rustup target add wasm32-unknown-unknown

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cd crates/ghostpass-crypto-wasm && wasm-pack build --target web

# ---------------------------------------------------------------------------
# Étage 2 — le lot statique
# ---------------------------------------------------------------------------
FROM docker.io/library/node:22.20.0-bookworm-slim AS build

WORKDIR /src
# Le paquet WASM d'abord : `npm ci` résout `file:` au moment de l'installation,
# et un répertoire absent y est une erreur, pas un avertissement.
COPY --from=wasm /src/crates/ghostpass-crypto-wasm/pkg ./crates/ghostpass-crypto-wasm/pkg
WORKDIR /src/apps/web-next
COPY apps/web-next/package.json apps/web-next/package-lock.json ./
RUN npm ci
COPY apps/web-next/ ./
# Les documents légaux, HORS de `apps/web-next/` : la page `/confidentialite`
# rend `docs/legal/politique-de-confidentialite.md`, lu au moment de la
# construction (voir `src/app/confidentialite/page.tsx`). Sans cette ligne, la
# construction échoue — bruyamment, ce qui vaut mieux qu'une page absente d'une
# image que rien ne distingue d'une bonne.
COPY docs/legal /src/docs/legal
# `prebuild` copie le module WASM dans `public/`, d'où `src/lib/crypto.ts` le
# charge. Il vient de l'étage ci-dessus, pas du dépôt.
RUN npm run build

# ---------------------------------------------------------------------------
# Image finale
# ---------------------------------------------------------------------------
FROM docker.io/library/nginx:1.27-alpine

# Valeur par défaut alignée sur le nom que pose le Quadlet. Elle est surchargeable
# précisément pour que l'image ne présume pas de son voisinage.
ENV GHOSTPASS_API=http://ghostpass-app:3000

COPY --from=build /src/apps/web-next/out /usr/share/nginx/html
COPY apps/web-next/nginx.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 8080
