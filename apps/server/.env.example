# Backend GhostPass — configuration (12-factor). Copier en `.env` et adapter.

# Port d'écoute.
PORT=3000

# Base de données.
#   - Non défini  → SQLite (dev) sur DB_PATH.
#   - Défini      → PostgreSQL (prod), ex. postgres://user:pass@host:5432/ghostpass
# DATABASE_URL=postgres://ghostpass:ghostpass@localhost:5432/ghostpass
DB_PATH=ghostpass.db

# CORS (origine autorisée pour la web app ; vide = désactivé).
# CORS_ORIGIN=https://vault.example.com

# WebAuthn (2FA + passkeys). rpID = DOMAINE (pas une IP) ; contexte sécurisé requis (https/localhost).
# WEBAUTHN_RP_ID=vault.example.com
# WEBAUTHN_ORIGIN=https://vault.example.com
# Related Origin Requests : origines liées supplémentaires (extensions), séparées par des virgules.
# WEBAUTHN_EXTRA_ORIGINS=chrome-extension://<id-publie>

# SSO OIDC (entreprise). Activé ⇔ OIDC_ISSUER défini. Le mot de passe maître reste requis côté
# client pour déverrouiller le coffre (zero-knowledge). Le SSO relie à un compte EXISTANT via
# l'email vérifié (pas de provisioning JIT). Fonctionne avec tout IdP OIDC (Google, Microsoft,
# Keycloak, …) exposant /.well-known/openid-configuration.
# OIDC_ISSUER=https://accounts.example.com
# OIDC_CLIENT_ID=ghostpass
# OIDC_CLIENT_SECRET=change-me
# OIDC_REDIRECT_URI=https://vault.example.com/api/auth/sso/callback
# Certains émetteurs n'émettent AUCUN claim applicatif — Cloudflare Access est de
# ceux-là. Le SSO échoue alors pour tout le monde, à la dernière étape, d'une façon
# indiscernable d'un SSO éteint. Ce drapeau fait porter la preuve de l'adresse par
# l'émetteur plutôt que par le claim ; il n'accepte que les jetons signés par
# `OIDC_ISSUER`, et refuse toujours un `email_verified: false` explicite.
# OIDC_TRUST_ISSUER_EMAIL=false

# SSO mobile (application iPhone). Activé ⇔ OIDC_MOBILE_REDIRECT_URI défini, en plus du SSO.
# L'IdP renvoie ICI (pas sur le SPA) : l'adresse doit être enregistrée côté IdP au même titre que
# OIDC_REDIRECT_URI. Jamais déduite de l'en-tête Host, qui est fourni par le client.
# OIDC_MOBILE_REDIRECT_URI=https://vault.example.com/api/auth/sso/mobile/callback
# Liste blanche des adresses de retour vers l'application, séparées par des virgules,
# en correspondance EXACTE. Sur iOS n'importe quelle application peut revendiquer un schéma
# d'URL : c'est le serveur qui choisit où repart le code, jamais le corps de l'échange.
# Défaut si non défini : ch.stackops.ghostpass://sso
# SSO_MOBILE_REDIRECT_URIS=ch.stackops.ghostpass://sso

# Niveau de log (fastify).
LOG_LEVEL=warn
